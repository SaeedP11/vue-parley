{
  "name": "vue-parley",
  "version": "3.1.0",
  "type": "module",
  "description": "Drop-in Vue 3 chat and video-call UI, driven by your own backend handlers.",
  "keywords": [
    "vue",
    "vue3",
    "chat",
    "messaging",
    "webrtc",
    "video-call",
    "pinia",
    "component"
  ],
  "homepage": "https://github.com/yonus-a/vue-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yonus-a/vue-chat.git"
  },
  "bugs": {
    "url": "https://github.com/yonus-a/vue-chat/issues"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./fakes": {
      "types": "./dist/types/fakes.d.ts",
      "import": "./dist/fakes.mjs",
      "require": "./dist/fakes.cjs"
    },
    "./style.css": "./dist/chat.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "dev": "vite build --watch",
    "demo": "pnpm build && pnpm --filter demo dev",
    "demo:build": "pnpm build && pnpm --filter demo build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:harness": "vite --config e2e/vite.config.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@vueuse/core": "^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0",
    "pinia": "^2.2.0 || ^3.0.0 || ^4.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^9.0.0 || ^10.0.0 || ^11.0.0"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-virtual": "^3.13.24",
    "nanoid": "^6.0.0",
    "vue3-emoji-picker": "^1.1.8",
    "vue3-lottie": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^22.10.0",
    "@types/simple-peer": "^9.11.9",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vueuse/core": "^14.2.1",
    "pinia": "^2.3.0",
    "postcss": "^8.5.17",
    "simple-peer": "^9.11.1",
    "tailwindcss": "4.3.2",
    "typescript": "^5.7.0",
    "unplugin-auto-import": "^0.18.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.5.31",
    "vue-i18n": "^11.4.5",
    "vue-tsc": "^2.2.0"
  }
}
