{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist/types",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@i18n/*": ["./i18n/*"]
    },
    "types": ["vite/client", "node"]
  },  
  "include": [
    "app/**/*.ts",
    "app/**/*.d.ts",
    "app/**/*.vue",
    "i18n/**/*.ts",
    "fakes/**/*.ts",
    "auto-imports.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app/components/call2",
    // Unused, and written against call-store fields that no longer exist.
    "app/components/call/paint-board"
  ]
}
